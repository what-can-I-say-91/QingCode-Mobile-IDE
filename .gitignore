# ============================================================
# 轻码编辑器 QingCode —— .gitignore
# 基于 GitHub Android 官方模板 + 本项目特有条目（见底部「本项目补充」）
# ============================================================

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files
# 注意：ignore 后 clone 到的新环境首次构建会自动生成新 keystore，
# 签名与已发布 APK 不同，覆盖安装会失败（需卸载重装）。
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Freeline
freeline.py
freeline/
freelineProject_properties.lock

# ============================================================
# 本项目补充（自定义 build.sh 产物，Android 模板不认识）
# ============================================================

# 构建输出目录（build.sh 的 OUT）
build/

# assets 打包产物：build.sh 每次构建从 web/ 整体复制 + 生成源码快照
app/src/main/assets/editor/
app/src/main/assets/source/

# macOS 垃圾文件
.DS_Store
